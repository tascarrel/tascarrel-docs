---
import { getCollection } from "astro:content";
import { slugFromEntry } from "../lib/blog.ts";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<nav class="blog-sidebar" aria-label="Blog posts">
  <p class="blog-sidebar-label">All Posts</p>
  <ul>
    {
      posts.map((post) => {
        const slug = slugFromEntry(post);
        return (
          <li>
            <a
              href={`/blog/${slug}`}
              class:list={[
                "blog-sidebar-link",
                slug === currentSlug && "is-active",
              ]}
              aria-current={slug === currentSlug ? "page" : undefined}
            >
              <span class="blog-sidebar-date">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
              <span>{post.data.title}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .blog-sidebar {
    font-size: 0.85rem;
  }

  .blog-sidebar-label {
    margin: 0 0 0.75rem;
    color: var(--theme-content-subtle);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-sidebar ul {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-sidebar-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.45rem 0.6rem;
    border-left: 2px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--theme-content-muted);
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s,
      border-color 0.15s;
  }

  .blog-sidebar-link:hover {
    color: var(--theme-content);
    background: var(--theme-surface-2);
  }

  .blog-sidebar-link.is-active {
    border-left-color: var(--theme-primary);
    color: var(--theme-primary);
    background: var(--theme-primary-muted);
    font-weight: 500;
  }

  .blog-sidebar-date {
    color: var(--theme-content-subtle);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>

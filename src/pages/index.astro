---
import { Image } from "astro:assets";
import { BaseLayout, Button, Section } from "@silitics/astro-theme";
import tascarrelWorkbench from "../assets/tascarrel-workbench.png";
import SiteFooter from "../layouts/SiteFooter.astro";
import { brand, headerActions, nav } from "../site.ts";

const delegationCapabilities = [
  {
    title: "Run Tasks in Parallel",
    body: "Each task starts clean and keeps its own changes, processes, and network activity, so agents do not trip over one another.",
  },
  {
    title: "Set the Boundary Once",
    body: "Choose what a development context can reach, then let agents work inside that boundary without command-by-command approvals.",
  },
  {
    title: "Limit the Reach of Mistakes",
    body: "A dedicated workspace VM separates agent activity from your machine and other development contexts.",
  },
];

const oversightSteps = [
  {
    title: "Let Agents Keep Working",
    body: "Run several agent tasks at once and switch between them as work progresses. Queue follow-up prompts for delivery when an agent finishes its current turn.",
  },
  {
    title: "See What Needs You",
    body: "Workspace and task badges show where an agent needs a decision, where a turn failed, and which completed work you have not reviewed.",
  },
  {
    title: "Inspect the Result",
    body: "Inspect running applications alongside the agent session. Browse the resulting files, diffs, and commits before deciding whether the work is ready.",
  },
  {
    title: "Publish Deliberately",
    body: "Choose which branches agents may publish automatically and which require your approval. Review proposed Git updates before they reach the upstream repository.",
  },
];

const existingSetupCapabilities = [
  {
    title: "Bring Your Agent Subscriptions",
    body: "Sign in to Codex with ChatGPT, connect Claude Code with a setup token, or use Tasci with an OpenAI-compatible endpoint.",
  },
  {
    title: "Declare the Development Context",
    body: "Define repositories, tools, resources, and access policies once, then reuse that setup for every fresh task.",
  },
  {
    title: "Run Real Development Workloads",
    body: "Use containers, Nix, nested virtualization, shared caches, or declared USB devices when the project requires them.",
  },
  {
    title: "Use Host-Injected Credentials",
    body: "Tascarrel handles Git authentication and injects eligible HTTP credentials on the host. Neither type of credential enters the workspace VM or task environment.",
  },
];
---

<BaseLayout
  title="Tascarrel: Let Agents Work Safely Without Babysitting"
  description="Tascarrel isolates declaratively defined development contexts in VMs, so coding agents can work safely with broad permissions without command-by-command approvals."
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <Section
    background="hero"
    padding="none"
    class="overflow-hidden pt-20 pb-20 md:pt-28 md:pb-24 lg:pt-32 lg:pb-28"
  >
    <div
      slot="decoration"
      class="bg-grid-fade absolute inset-0"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-7xl text-center">
      <div class="badge hero-badge">
        <span class="text-primary">Open-Source</span>
        <span>Agentic Development Workbench</span>
      </div>
      <h1
        class="font-display mx-auto mt-5 max-w-4xl text-balance text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
      >
        Let Agents Work Safely{" "}
        <span class="text-gradient">Without Babysitting</span>
      </h1>
      <figure class="product-shot mt-10">
        <div class="product-shot-frame">
          <Image
            src={tascarrelWorkbench}
            alt="Tascarrel showing workspace and task navigation, a Codex agent session, and a live application preview side by side"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        </div>
      </figure>
      <ul
        class="hero-capabilities mx-auto mt-7 max-w-5xl"
        aria-label="Core capabilities"
      >
        <li>Bring Your Subscriptions</li>
        <li>Layered VM and Task Isolation</li>
        <li>Controlled Network Access</li>
        <li>Host-Injected Credentials</li>
      </ul>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="/docs/getting-started/installation">
          Install Tascarrel
        </Button>
        <Button variant="secondary" href="/docs">Read the Docs</Button>
      </div>
    </div>
  </Section>

  <Section background="section" padding="default">
    <div
      class="mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-20"
    >
      <div>
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Autonomy through Isolation
        </p>
        <h2
          class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl"
        >
          Delegate More Work with Confidence
        </h2>
        <p class="text-content-muted mt-5 text-lg leading-relaxed">
          Tascarrel makes unattended agent work practical by isolating each
          development context in its own VM. Agents get broad permissions inside
          the boundary you define, while clean task environments make parallel
          work predictable.
        </p>
        <p class="text-content-subtle mt-5 text-sm leading-relaxed">
          The workspace VM is the safety boundary. Task environments provide
          lightweight separation within it.
        </p>
        <div class="mt-8">
          <Button
            variant="secondary"
            href="/docs/getting-started/isolation-model"
          >
            Understand the Isolation Model
          </Button>
        </div>
      </div>
      <div class="divide-divider border-divider divide-y border-y">
        {
          delegationCapabilities.map((capability) => (
            <div class="py-6">
              <h3 class="font-display text-lg font-semibold">
                {capability.title}
              </h3>
              <p class="text-content-muted mt-2 leading-relaxed">
                {capability.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="none" padding="default">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-primary text-xs font-semibold tracking-widest uppercase">
        Oversight When It Matters
      </p>
      <h2 class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl">
        Stay on Top without Staying Glued to It
      </h2>
      <p class="text-content-muted mt-4 text-lg leading-relaxed">
        The UI keeps active work, results, and publication decisions in one
        place. You can move on while agents work, then return with the context
        needed to review what they produced.
      </p>
    </div>
    <ol class="oversight-flow mx-auto mt-12 max-w-6xl">
      {
        oversightSteps.map((step, index) => (
          <li>
            <p class="text-primary font-mono text-xs font-semibold">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="font-display mt-3 text-lg font-semibold">
              {step.title}
            </h3>
            <p class="text-content-muted mt-2 text-sm leading-relaxed">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section background="section" padding="default">
    <div
      class="mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-[1fr_1.25fr] lg:gap-20"
    >
      <div>
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Your Existing Development Setup
        </p>
        <h2
          class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl"
        >
          Add the Workbench, Not Another Stack
        </h2>
        <p class="text-content-muted mt-5 text-lg leading-relaxed">
          Keep the agents, subscriptions, repositories, and development tools
          you already use. Tascarrel gives them a reusable context and one place
          to work together.
        </p>
      </div>
      <div class="value-grid">
        {
          existingSetupCapabilities.map((capability) => (
            <div>
              <h3 class="font-display text-lg font-semibold">
                {capability.title}
              </h3>
              <p class="text-content-muted mt-2 leading-relaxed">
                {capability.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="cta" padding="default">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-primary text-xs font-semibold tracking-widest uppercase">
        Apple Silicon macOS · x86-64 and AArch64 Linux
      </p>
      <h2 class="font-display mt-3 text-3xl font-bold md:text-4xl">
        Install Tascarrel on Your Machine
      </h2>
      <p class="text-content-muted mt-4 text-lg">
        Create your first isolated workspace and give an agent a task in
        minutes.
      </p>
      <pre
        class="install-command mx-auto mt-8 max-w-2xl text-left"><code>curl --proto '=https' --tlsv1.2 -fsSL \
  https://tascarrel.dev/install.sh | sh</code></pre>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/docs/getting-started/installation">
          Installation Guide
        </Button>
        <Button
          variant="secondary"
          href="https://github.com/tascarrel/tascarrel"
        >
          View on GitHub
        </Button>
      </div>
      <p class="text-content-subtle mx-auto mt-8 max-w-xl text-sm">
        <strong>Tascarrel is still experimental.</strong> Do not entrust it with important
        or confidential data. Use it only with data you can afford to lose or leak.
      </p>
    </div>
  </Section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .product-shot {
    position: relative;
    isolation: isolate;
  }

  .hero-badge {
    justify-content: center;
  }

  .hero-capabilities li {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--theme-content-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero-capabilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 0.75rem;
    row-gap: 0.5rem;
  }

  .hero-capabilities li + li::before {
    color: var(--theme-primary);
    font-size: 1rem;
    content: "·";
  }

  .product-shot::before {
    position: absolute;
    z-index: -1;
    inset: 8% 4% 2%;
    border-radius: 2rem;
    background: color-mix(in srgb, var(--theme-primary) 24%, transparent);
    filter: blur(4rem);
    content: "";
  }

  .product-shot-frame {
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--theme-primary) 45%, var(--theme-divider));
    border-radius: 0.85rem;
    background: black;
    box-shadow:
      0 2rem 5rem -2.5rem
        color-mix(in srgb, var(--theme-primary) 55%, transparent),
      0 1.5rem 3rem -2rem rgb(0 0 0 / 80%),
      inset 0 1px rgb(255 255 255 / 10%);
  }

  .oversight-flow {
    display: grid;
    gap: 2rem;
  }

  .oversight-flow li,
  .value-grid > div {
    border-top: 1px solid var(--theme-divider);
    padding-top: 1.25rem;
  }

  .value-grid {
    display: grid;
    gap: 2rem;
  }

  .install-command {
    overflow-x: auto;
    border: 1px solid var(--theme-divider);
    border-radius: 0.65rem;
    background: var(--theme-surface-0);
    padding: 1rem 1.25rem;
    color: var(--theme-content);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media (max-width: 767px) {
    .hero-badge {
      max-width: 17rem;
      flex-wrap: wrap;
      row-gap: 0.25rem;
      line-height: 1.35;
    }
  }

  @media (min-width: 768px) {
    .oversight-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .value-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .oversight-flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

---
import { Image } from "astro:assets";
import { BaseLayout, Button, Section } from "@silitics/astro-theme";
import tascarrelWorkbench from "../assets/tascarrel-workbench.png";
import SiteFooter from "../layouts/SiteFooter.astro";
import { brand, headerActions, nav } from "../site.ts";

const delegationCapabilities = [
  {
    title: "Run Tasks in Parallel",
    body: "Every task gets its own pod: a fresh copy of the workspace with private files, processes, and network. Run as many at once as your hardware allows, without them stepping on each other.",
  },
  {
    title: "Declare the Boundary Once",
    body: "Say what a workspace may reach. After that, agents build, test, and install inside it without asking you to approve each command.",
  },
  {
    title: "Contain Untrusted Code",
    body: "Each workspace VM runs its own kernel behind a hardware-virtualized boundary, separate from your machine and every other workspace. It is built to hold against code that actively tries to escape.",
  },
];

const multiRepositoryChanges = [
  {
    path: "product/web",
    summary: "Account settings and audit timeline",
    files: "3 files changed",
  },
  {
    path: "services/api",
    summary: "Audit event contract and persistence",
    files: "5 files changed",
  },
  {
    path: "platform/deploy",
    summary: "Service permissions and rollout config",
    files: "2 files changed",
  },
];

const gitMediationSteps = [
  {
    scope: "Agent Pod",
    title: "Prepare the Change",
    body: "Edit, test, commit, fetch, and push inside the pod with normal Git tooling.",
  },
  {
    scope: "Tascarrel Host",
    title: "Evaluate the Proposal",
    body: "Turn the push into exact ref updates and apply branch, tag, and approval policy.",
  },
  {
    scope: "Git Upstream",
    title: "Publish What Is Allowed",
    body: "Use host-owned credentials and object leases to publish the approved updates.",
  },
];

const oversightSteps = [
  {
    title: "Queue Work and Walk Away",
    body: "Send a follow-up prompt while an agent is mid-turn and it arrives when the turn ends. Switch between pods without interrupting any of them.",
  },
  {
    title: "See What Needs You",
    body: "The workbench shows you whatever needs a decision, from a finished task to a push held for approval. You never have to go looking.",
  },
  {
    title: "Take Over When You Need To",
    body: "Open a terminal, an editor, or the running application inside the pod. Reproduce a failure, fix something by hand, then hand the task back to the agent.",
  },
  {
    title: "Read the Diff",
    body: "Browse the files, diffs, and commits a task produced, then decide whether the work is ready.",
  },
];

const existingSetupCapabilities = [
  {
    title: "Bring Your Agent Subscriptions",
    body: "Use Codex or Claude Code with the subscription you already pay for, or Tascarrel's agent with any OpenAI-compatible endpoint. Point it at a local model and no prompt leaves your hardware.",
  },
  {
    title: "Keep the Setup in Version Control",
    body: "Repositories, tools, caches, and access rules live in a Dockerfile and a config.toml your team can review like any other file. Every fresh pod starts from them.",
  },
  {
    title: "Run Real Development Workloads",
    body: "Use containers, Nix, nested virtualization, shared caches, or forward a USB device from a Linux host when the project requires it.",
  },
  {
    title: "Use Host-Injected Credentials",
    body: "Git authentication happens on the host. For HTTP APIs, the workload sends a placeholder and the host swaps in the real secret once the request has left the VM.",
  },
];
---

<BaseLayout
  title="Tascarrel: Real Isolation for Coding Agents, on Your Hardware"
  description="Tascarrel runs each project in its own VM on your own hardware, so coding agents can build, test, and install without command-by-command approvals."
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <Section
    background="hero"
    padding="none"
    class="overflow-hidden pt-20 pb-20 md:pt-28 md:pb-24 lg:pt-32 lg:pb-28"
  >
    <div
      slot="decoration"
      class="bg-grid-fade absolute inset-0"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-7xl text-center">
      <div class="badge hero-badge">
        <span class="text-primary">Open-Source</span>
        <span>Agentic Development Workbench</span>
      </div>
      <h1
        class="font-display mx-auto mt-5 max-w-4xl text-balance text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
      >
        Real Isolation for Coding Agents,{" "}
        <span class="text-gradient">on Your Hardware</span>
      </h1>
      <p
        class="font-display mx-auto mt-6 max-w-3xl text-balance text-xl font-semibold md:text-2xl"
      >
        No command approvals. Every task starts clean.
      </p>
      <p
        class="text-content-muted mx-auto mt-4 max-w-2xl text-lg leading-relaxed"
      >
        Each workspace gets its own VM, and each task a disposable pod within
        it. Inside that pod, an agent can install, build, and run anything. Git
        operations and HTTP APIs are mediated through the host. The required
        secrets never enter the VM.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="/docs/getting-started/installation">
          Install Tascarrel
        </Button>
        <Button variant="secondary" href="/docs/getting-started/quickstart">
          Run Your First Task
        </Button>
      </div>
      <figure class="product-shot mt-12">
        <div class="product-shot-frame">
          <Image
            src={tascarrelWorkbench}
            alt="Tascarrel showing workspace and pod navigation, a Codex agent session, and a live application preview side by side"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            widths={[640, 960, 1280, 1920, 2560]}
            sizes="(min-width: 1280px) 1152px, (min-width: 768px) 92vw, 100vw"
            class="block h-auto w-full"
          />
        </div>
      </figure>
      <p class="hero-specs mx-auto mt-8 max-w-3xl">
        Apple Silicon macOS · x86-64 and AArch64 Linux · Apache-2.0 or MIT
      </p>
    </div>
  </Section>

  <Section background="section" padding="default">
    <div
      class="mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-20"
    >
      <div>
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Autonomy through Isolation
        </p>
        <h2
          class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl"
        >
          Delegate More Work with Confidence
        </h2>
        <p class="text-content-muted mt-5 text-lg leading-relaxed">
          An agent on your machine runs with all your access, so you approve its
          commands one by one. In a workspace VM it gets only what you granted
          that workspace, so you can leave it alone.
        </p>
        <p class="text-content-subtle mt-5 text-sm leading-relaxed">
          The workspace VM is the safety boundary. Pods provide lightweight
          separation within it.
        </p>
        <div class="mt-8">
          <Button
            variant="secondary"
            href="/blog/how-tascarrel-isolates-coding-agents"
          >
            Read the Architecture Write-Up
          </Button>
        </div>
      </div>
      <div class="divide-divider border-divider divide-y border-y">
        {
          delegationCapabilities.map((capability) => (
            <div class="py-6">
              <h3 class="font-display text-lg font-semibold">
                {capability.title}
              </h3>
              <p class="text-content-muted mt-2 leading-relaxed">
                {capability.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="none" padding="default">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20"
    >
      <div>
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Multi-Repository Workspaces
        </p>
        <h2
          class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl"
        >
          One Task Can Cross the Whole Product
        </h2>
        <p class="text-content-muted mt-5 text-lg leading-relaxed">
          Give an agent every related repository in one workspace. It can trace
          contracts across codebases, make coordinated changes, and run the
          complete system without losing the thread between them.
        </p>
        <p class="text-content-subtle mt-5 text-sm leading-relaxed">
          Each repository keeps its own history and publication policy, so you
          can review and publish them one at a time.
        </p>
        <div class="mt-8">
          <Button variant="secondary" href="/docs/guides/configure-a-workspace">
            Configure a Workspace
          </Button>
        </div>
      </div>

      <figure
        class="multi-repository-proof"
        aria-labelledby="multi-repository-proof-title"
      >
        <figcaption class="multi-repository-proof-header">
          <span>
            <span class="multi-repository-proof-label">Example Task</span>
            <strong id="multi-repository-proof-title">
              Add an account audit trail
            </strong>
          </span>
          <span class="multi-repository-proof-status">Ready for Review</span>
        </figcaption>
        <div class="multi-repository-proof-body">
          <p class="multi-repository-proof-overline">
            Coordinated Changes · 3 Repositories
          </p>
          <ol class="multi-repository-change-list">
            {
              multiRepositoryChanges.map((repository) => (
                <li>
                  <span class="multi-repository-path">
                    /workspace/{repository.path}
                  </span>
                  <span class="multi-repository-summary">
                    {repository.summary}
                  </span>
                  <span class="multi-repository-files">{repository.files}</span>
                </li>
              ))
            }
          </ol>
          <div class="multi-repository-proof-result">
            <span>One isolated task</span>
            <strong>10 changed files across the product</strong>
          </div>
        </div>
      </figure>
    </div>
  </Section>

  <Section background="section" padding="default">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Host-Mediated Git
        </p>
        <h2
          class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl"
        >
          Let Agents Commit. Keep Publish Authority.
        </h2>
        <p class="text-content-muted mt-4 text-lg leading-relaxed">
          The Tascarrel host is the only component that contacts upstream Git.
          Agents work with familiar Git commands, while fetches and pushes cross
          a mediated boundary.
        </p>
      </div>

      <ol class="git-mediation-flow mt-12">
        {
          gitMediationSteps.map((step, index) => (
            <li>
              <p class="git-mediation-step">
                <span>{String(index + 1).padStart(2, "0")}</span>
                {step.scope}
              </p>
              <h3 class="font-display mt-3 text-lg font-semibold">
                {step.title}
              </h3>
              <p class="text-content-muted mt-2 text-sm leading-relaxed">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="git-mediation-assurance">
        <p>
          <span>Credential Boundary</span>
          <strong>
            Upstream Git credentials never enter the workspace VM.
          </strong>
        </p>
        <Button
          variant="secondary"
          href="/docs/guides/review-and-publish-changes"
        >
          Review and Publish Changes
        </Button>
      </div>
    </div>
  </Section>

  <Section background="none" padding="default">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-primary text-xs font-semibold tracking-widest uppercase">
        Oversight When It Matters
      </p>
      <h2 class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl">
        Stay on Top without Staying Glued to It
      </h2>
      <p class="text-content-muted mt-4 text-lg leading-relaxed">
        Agents keep working whether or not you are watching. The workbench is
        what you come back to: what finished, what needs a decision, and what
        the code now looks like.
      </p>
    </div>
    <ul class="oversight-flow mx-auto mt-12 max-w-6xl">
      {
        oversightSteps.map((step) => (
          <li>
            <h3 class="font-display text-lg font-semibold">{step.title}</h3>
            <p class="text-content-muted mt-2 text-sm leading-relaxed">
              {step.body}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section background="section" padding="default">
    <div
      class="mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-[1fr_1.25fr] lg:gap-20"
    >
      <div>
        <p class="text-primary text-xs font-semibold tracking-widest uppercase">
          Your Existing Development Setup
        </p>
        <h2
          class="font-display mt-3 text-balance text-3xl font-bold md:text-4xl"
        >
          Add the Workbench, Not Another Stack
        </h2>
        <p class="text-content-muted mt-5 text-lg leading-relaxed">
          Keep the agents, subscriptions, repositories, and development tools
          you already use. Tascarrel gives them a reusable context and one place
          to work together.
        </p>
      </div>
      <div class="value-grid">
        {
          existingSetupCapabilities.map((capability) => (
            <div>
              <h3 class="font-display text-lg font-semibold">
                {capability.title}
              </h3>
              <p class="text-content-muted mt-2 leading-relaxed">
                {capability.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="cta" padding="default">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-balance text-3xl font-bold md:text-4xl">
        Install Tascarrel on Your Machine
      </h2>
      <p class="text-content-muted mt-4 text-lg leading-relaxed">
        Create your first isolated workspace and give an agent a task in
        minutes.
      </p>
      <pre
        class="install-command mx-auto mt-8 max-w-2xl text-left"><code>curl --proto '=https' --tlsv1.2 -fsSL \
  https://tascarrel.dev/install.sh | sh</code></pre>
      <p
        class="text-content-subtle mx-auto mt-4 max-w-2xl text-sm leading-relaxed"
      >
        You will need QEMU and Git on the host. The installer itself needs no
        root: it verifies the release checksum, puts <code>tascarrel</code> and
        <code>tascarrelctl</code> in <code>~/.local/bin</code>, and registers a
        per-user service. Rather read it first? Fetch
        <a href="/install.sh">install.sh</a>, check it, then run it.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/docs/getting-started/installation">
          Installation Guide
        </Button>
        <Button
          variant="secondary"
          href="https://github.com/tascarrel/tascarrel"
        >
          View on GitHub
        </Button>
      </div>
    </div>
  </Section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero-badge {
    justify-content: center;
  }

  .hero-specs {
    color: var(--theme-content-subtle);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .product-shot-frame {
    overflow: hidden;
    border: 1px solid oklch(from var(--theme-primary) l c h / 0.5);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 40px var(--theme-glow-primary);
  }

  .multi-repository-proof {
    overflow: hidden;
    border: 1px solid var(--theme-divider);
    border-radius: var(--radius-lg);
    background: var(--theme-surface-0);
    box-shadow: 0 24px 70px
      color-mix(in oklab, var(--theme-glow-primary) 48%, transparent);
  }

  .multi-repository-proof-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--theme-divider);
    padding: 1.25rem 1.5rem;
  }

  .multi-repository-proof-header > span:first-child {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .multi-repository-proof-header strong {
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .multi-repository-proof-label,
  .multi-repository-proof-overline {
    color: var(--theme-content-subtle);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .multi-repository-proof-status {
    flex: none;
    border: 1px solid
      color-mix(in oklab, var(--theme-primary) 45%, var(--theme-divider));
    border-radius: 999px;
    background: color-mix(
      in oklab,
      var(--theme-primary) 10%,
      var(--theme-surface-0)
    );
    padding: 0.3rem 0.55rem;
    color: var(--theme-primary);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .multi-repository-proof-body {
    padding: 1.5rem;
  }

  .multi-repository-change-list {
    display: grid;
    margin-top: 0.75rem;
  }

  .multi-repository-change-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    border-top: 1px solid var(--theme-divider);
    padding: 1rem 0;
  }

  .multi-repository-path {
    min-width: 0;
    overflow: hidden;
    color: var(--theme-content);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .multi-repository-summary {
    color: var(--theme-content-muted);
    font-size: 0.8125rem;
  }

  .multi-repository-files {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--theme-content-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .multi-repository-proof-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid
      color-mix(in oklab, var(--theme-primary) 32%, var(--theme-divider));
    border-radius: calc(var(--radius-lg) * 0.65);
    background: color-mix(
      in oklab,
      var(--theme-primary) 7%,
      var(--theme-surface-0)
    );
    padding: 0.9rem 1rem;
  }

  .multi-repository-proof-result span {
    color: var(--theme-content-subtle);
    font-size: 0.75rem;
  }

  .multi-repository-proof-result strong {
    color: var(--theme-content);
    font-size: 0.8125rem;
    text-align: right;
  }

  .git-mediation-flow {
    display: grid;
    border: 1px solid var(--theme-divider);
    border-radius: var(--radius-lg);
    background: var(--theme-surface-0);
  }

  .git-mediation-flow li {
    padding: 1.5rem;
  }

  .git-mediation-flow li + li {
    border-top: 1px solid var(--theme-divider);
  }

  .git-mediation-step {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--theme-primary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .git-mediation-step span {
    color: var(--theme-content-subtle);
  }

  .git-mediation-assurance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.5rem;
    border-left: 2px solid var(--theme-primary);
    padding: 0.25rem 0 0.25rem 1rem;
  }

  .git-mediation-assurance p {
    display: grid;
    gap: 0.25rem;
  }

  .git-mediation-assurance span {
    color: var(--theme-content-subtle);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .git-mediation-assurance strong {
    color: var(--theme-content);
    font-size: 0.875rem;
  }

  .oversight-flow {
    display: grid;
    gap: 2rem;
  }

  .oversight-flow li,
  .value-grid > div {
    border-top: 1px solid var(--theme-divider);
    padding-top: 1.25rem;
  }

  .value-grid {
    display: grid;
    gap: 2rem;
  }

  .install-command {
    overflow-x: auto;
    border: 1px solid var(--theme-divider);
    border-radius: 0.65rem;
    background: var(--theme-surface-0);
    padding: 1rem 1.25rem;
    color: var(--theme-content);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media (max-width: 767px) {
    .hero-badge {
      max-width: 17rem;
      flex-wrap: wrap;
      row-gap: 0.25rem;
      line-height: 1.35;
    }

    .multi-repository-proof-header,
    .multi-repository-proof-result {
      align-items: flex-start;
      flex-direction: column;
    }

    .multi-repository-change-list li {
      grid-template-columns: minmax(0, 1fr);
    }

    .multi-repository-files {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.2rem;
    }

    .multi-repository-proof-result strong {
      text-align: left;
    }

    .git-mediation-assurance {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (min-width: 768px) {
    .git-mediation-flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .git-mediation-flow li + li {
      border-top: 0;
      border-left: 1px solid var(--theme-divider);
    }

    .oversight-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .value-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .oversight-flow {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
